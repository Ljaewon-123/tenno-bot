DISCORD_TOKEN=
# dev 전용 — 커맨드를 이 길드에만 즉시 등록한다
DISCORD_DEVELOPMENT_GUILD_ID=
PORT=3000
PG_DATABASE_URL=
# Supabase 대시보드 > Project Settings > Database > Download certificate
# PEM 내용을 개행 그대로 붙여넣고 큰따옴표로 감싼다 (dotenv가 여러 줄 값을 읽는다)
PG_CA_CERT=
DEV_DB=
# top.gg 승인 후 발급 — 비워 두면 서버 수 전송을 건너뛴다
TOPGG_TOKEN=
# 서포트 서버 피드백 채널 > 연동 > 웹후크 URL — 비워 두면 /feedback이 서포트 서버로 안내한다
FEEDBACK_WEBHOOK_URL=